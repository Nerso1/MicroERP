# Copy this file to .env (git-ignored) and adjust values if needed.
# Local development only -> never use this password outside your machine.
MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# Optional: host ports (uncomment if the defaults are already taken on your machine).
# API_PORT=8080
# DB_PORT=1433

# Optional: Azure Service Bus connection string (SAS policy "api-send" on queue "stock-alerts").
# Leave commented out to run without Azure -> the API container only logs stock alerts.
# AZURE_SERVICEBUS_CONNECTION_STRING=
